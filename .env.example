# Database
# Host ports are the *published* container ports (override if 5432/6379 are taken)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql://cashflow:cashflow@localhost:5432/cashflow

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# LLM (local Ollama in Docker; the API-compatible provider name is "openai")
LLM_PROVIDER=openai
LLM_MODEL=qwen3:1.7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL_DOCKER=http://ollama:11434/v1
# Ollama ignores this placeholder; replace it with a real key for a hosted OpenAI provider.
OPENAI_API_KEY=ollama-local
# Optional external embeddings key. Leave blank to keep all inference local.
OPENAI_EMBEDDING_API_KEY=
# Optional if switching back to Gemini
GEMINI_API_KEY=
# Optional OpenAI-compatible embeddings for remittance semantic retrieval
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1

# Auth/RBAC
JWT_SECRET=dev_secret_change_in_prod
DEFAULT_USER_ROLE=viewer

# App Config
APPROVAL_THRESHOLD=1000.00
MAX_JOB_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
