# Database
# Host ports are the *published* container ports (override if 5432/6379 are taken)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql://cashflow:cashflow@localhost:5432/cashflow

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# LLM (Gemini API free tier; alternatively use openai or anthropic)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Leave the selected provider's API key blank to use the deterministic rule-based fallback
OPENAI_API_KEY=
# Optional OpenAI-compatible embeddings for remittance semantic retrieval
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=            # override for OpenAI-compatible gateways
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1

# Auth/RBAC
JWT_SECRET=dev_secret_change_in_prod
DEFAULT_USER_ROLE=viewer

# App Config
APPROVAL_THRESHOLD=1000.00
MAX_JOB_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
